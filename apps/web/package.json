{
  "name": "@quorum-backoffice/web",
  "version": "0.1.0",
  "private": true,
  "description": "Backoffice admin UI (Next.js App Router + shadcn/ui).",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p ${PORT:-3002}",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=9999",
    "format": "prettier --write \"app/**/*.{ts,tsx,json,css}\" \"components/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,json,css}\" \"components/**/*.{ts,tsx,json,css}\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@quorum-backoffice/shared": "*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.0.0-beta.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.0.4",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0-beta.6",
    "typescript": "5.6.3"
  }
}
