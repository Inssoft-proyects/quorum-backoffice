{
  "name": "@quorum-backoffice/web",
  "version": "0.1.0",
  "private": true,
  "description": "Backoffice admin UI (Next.js App Router + shadcn/ui).",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "next lint",
    "format": "prettier --write \"app/**/*.{ts,tsx,json,css}\" \"components/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,json,css}\" \"components/**/*.{ts,tsx,json,css}\"",
    "test": "echo \"no web tests in WU0; component tests land in WU7+\" && exit 0"
  },
  "dependencies": {
    "@quorum-backoffice/shared": "*",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.0.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0-beta.6",
    "@types/node": "^22.10.5",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.0.4",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0-beta.6",
    "typescript": "5.6.3"
  }
}
