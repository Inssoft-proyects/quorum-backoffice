# Quorum Backoffice — root .env.example
# Copy to .env and fill in real values. NEVER commit .env.

# Node environment
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3001

# API service (apps/api/.env)
DATABASE_URL=postgresql://websop:quorum_backoffice_dev@127.0.0.1:5432/quorum_backoffice
REDIS_URL=redis://127.0.0.1:6379

# OTP service integration (sibling: /planQuorum/dev/quorum-otp)
OTP_SERVICE_URL=http://127.0.0.1:8080
OTP_SERVICE_TOKEN=replace-with-hmac-token-from-quorum-otp

# Canvas LMS via portal-api (sibling: /planQuorum/dev/quorum)
CANVAS_PORTAL_API_URL=http://127.0.0.1:3000
CANVAS_PORTAL_API_TOKEN=replace-with-token-from-portal-api

# Web (apps/web/.env)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# Session signing (32+ random bytes; NEVER reuse)
SESSION_SECRET=replace-with-openssl-rand-base64-32

# Bootstrap admin (created on first migration; rotate after first login)
BOOTSTRAP_ADMIN_EMAIL=admin@quorum.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-prod

# SMTP delivery for OTP emails (Polish WU v6: email+OTP login).
# Required in production. In dev/test, if SMTP_HOST is unset the mailer
# logs the OTP code to stdout (visible as a warn-level pino entry) and
# delivers nothing over the wire.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@quorum.local

# Login OTP tuning
LOGIN_OTP_TTL_SECONDS=300
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_REQUEST_MAX_PER_EMAIL=5
LOGIN_OTP_REQUEST_WINDOW_SECONDS=900
